# FocusFlow Environment Variables for Vercel Deployment

# Google Gemini API Key for AI Voice Assistant and Spatial Creation Studio
# (Set your Gemini API key from Google AI Studio)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Nitro Preset for Vercel (Auto-detected on Vercel, but recommended to keep explicit)
NITRO_PRESET=vercel
